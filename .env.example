# Copy to .env.local and fill in. Never commit .env.local.
# None of these may start with NEXT_PUBLIC_ — they are server-only.

# --- Location lookup (OpenStreetMap Nominatim) — REQUIRED for place search ---
# The public Nominatim usage policy requires a User-Agent that identifies your app
# with a real contact. Requests are refused while this placeholder is set.
NOMINATIM_USER_AGENT="KisaanSaathi/1.0 (contact: replace-with-your-email@example.com)"
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# --- Weather (Open-Meteo) — works without a key for NON-COMMERCIAL use ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=

# --- Gemini assistant — REQUIRED for "Ask Kisaan Saathi" and Crop Care help ---
# Create a key at https://aistudio.google.com/apikey . New keys start with "AQ." (auth keys);
# old "AIza" standard keys are rejected by Google from September 2026.
# Default model when empty: gemini-3.5-flash (falls back to gemini-3.8-flash, gemini-3.6-flash if retired).
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Daily scheme refresh — REQUIRED for scheme monitoring ---
# PostgreSQL connection string; run `npm run db:migrate` once after setting it.
DATABASE_URL=
# At least 16 random characters. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=
# Identifies the scheme monitor to government websites (falls back to NOMINATIM_USER_AGENT).
MONITOR_USER_AGENT=
